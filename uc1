#include <iostream>

// This line allows you to use names for objects and variables from the standard library
// like 'cout' and 'endl' without specifying 'std::' before them.
using namespace std;

// The main() function is where the execution of a C++ program begins.
int main() {
  // cout is used to output/print text to the console.
  // The << operator, also known as the insertion operator, sends the string to cout.
  cout << "Hello, World!";

  // return 0 indicates that the program has ended successfully.
  return 0;
}
